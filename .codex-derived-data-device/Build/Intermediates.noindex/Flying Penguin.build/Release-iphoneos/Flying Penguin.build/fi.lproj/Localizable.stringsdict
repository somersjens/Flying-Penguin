<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>notif.animal.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Vain %lld vanne jäljellä! ⭕</string>
			<key>other</key>
			<string>Vain %lld vanne jäljellä! ⭕</string>
		</dict>
	</dict>
	<key>notif.cards.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Pelaa tänään %lld minuutti ja kerää vielä muutama.</string>
			<key>other</key>
			<string>Pelaa tänään %lld minuutti ja kerää vielä muutama.</string>
		</dict>
	</dict>
	<key>notif.cards.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld vanne kerätty! ⭕</string>
			<key>other</key>
			<string>%lld vanne kerätty! ⭕</string>
		</dict>
	</dict>
	<key>notif.day3.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Aloita %lld minuutin pelisessio ja pidennä päivittäistä pelisarjaasi.</string>
			<key>other</key>
			<string>Aloita %lld minuutin pelisessio ja pidennä päivittäistä pelisarjaasi.</string>
		</dict>
	</dict>
	<key>notif.streak.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Pelaa %lld minuuttia ja jatka päivittäistä pelisarjaasi!</string>
			<key>other</key>
			<string>Pelaa %lld minuuttia ja jatka päivittäistä pelisarjaasi!</string>
		</dict>
	</dict>
	<key>notif.streak.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Päivittäinen peliputkesi on saavuttanut %lld päivää! 🔥</string>
			<key>other</key>
			<string>Päivittäinen peliputkesi on saavuttanut %lld päivää! 🔥</string>
		</dict>
	</dict>
	<key>notif.weekly.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Tämä nostaa yhteensä %lld vanne. Hämmästyttävää työtä!</string>
			<key>other</key>
			<string>Tämä nostaa yhteensä %lld vanne. Hämmästyttävää työtä!</string>
		</dict>
	</dict>
	<key>notif.weekly.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Ansaitsit %lld vanne tällä viikolla! 🎉</string>
			<key>other</key>
			<string>Ansaitsit %lld vanne tällä viikolla! 🎉</string>
		</dict>
	</dict>
	<key>parentGate.holdInstruction %@ %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Pidä %1$@ painettuna %2$lld sekuntia.</string>
			<key>other</key>
			<string>Pidä %1$@ painettuna %2$lld sekuntia.</string>
		</dict>
	</dict>
	<key>parentGate.tapInstruction %lld %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Napauta nyt %2$@ %1$lld kertaa.</string>
			<key>other</key>
			<string>Napauta nyt %2$@ %1$lld kertaa.</string>
		</dict>
	</dict>
</dict>
</plist>

			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Dalia'r %1$@ am %2$lld eiliad.</string>
			<key>other</key>
			<string>Dalia'r %1$@ am %2$lld eiliad.</string>
		</dict>
	</dict>

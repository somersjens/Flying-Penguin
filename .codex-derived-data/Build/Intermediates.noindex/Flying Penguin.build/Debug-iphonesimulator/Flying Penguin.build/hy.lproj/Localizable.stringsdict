<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>notif.animal.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Մնացել է ընդամենը %lld օղակ: ⭕</string>
			<key>other</key>
			<string>Մնացել է ընդամենը %lld օղակ: ⭕</string>
		</dict>
	</dict>
	<key>notif.cards.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Խաղա այսօր %lld րոպե ու մի քիչ էլ ավելացրու։</string>
			<key>other</key>
			<string>Խաղա այսօր %lld րոպե ու մի քիչ էլ ավելացրու։</string>
		</dict>
	</dict>
	<key>notif.cards.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld օղակ հավաքեցիր! ⭕</string>
			<key>other</key>
			<string>%lld օղակ հավաքեցիր! ⭕</string>
		</dict>
	</dict>
	<key>notif.day3.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Սկսեք %lld րոպեանոց խաղային նստաշրջան և երկարացրեք ձեր ամենօրյա խաղային շարանը:</string>
			<key>other</key>
			<string>Սկսեք %lld րոպեանոց խաղային նստաշրջան և երկարացրեք ձեր ամենօրյա խաղային շարանը:</string>
		</dict>
	</dict>
	<key>notif.streak.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Խաղացեք %lld րոպե և շարունակեք ձեր ամենօրյա խաղային շարանը:</string>
			<key>other</key>
			<string>Խաղացեք %lld րոպե և շարունակեք ձեր ամենօրյա խաղային շարանը:</string>
		</dict>
	</dict>
	<key>notif.streak.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Ձեր ամենօրյա խաղային շարանը հասել է %lld օրվա: 🔥</string>
			<key>other</key>
			<string>Ձեր ամենօրյա խաղային շարանը հասել է %lld օրվա: 🔥</string>
		</dict>
	</dict>
	<key>notif.weekly.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Դա ձեր ընդհանուր տիտղոսը հասցնում է %lld-ի:Զարմանալի աշխատանք!</string>
			<key>other</key>
			<string>Դա ձեր ընդհանուր տիտղոսը հասցնում է %lld-ի:Զարմանալի աշխատանք!</string>
		</dict>
	</dict>
	<key>notif.weekly.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Այս շաբաթ դուք վաստակեցիք %lld օղակ: 🎉</string>
			<key>other</key>
			<string>Այս շաբաթ դուք վաստակեցիք %lld օղակ: 🎉</string>
		</dict>
	</dict>
	<key>parentGate.holdInstruction %@ %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Սեղմած պահեք %1$@-ը %2$lld վայրկյան։</string>
			<key>other</key>
			<string>Սեղմած պահեք %1$@-ը %2$lld վայրկյան։</string>
		</dict>
	</dict>
	<key>parentGate.tapInstruction %lld %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Այժմ %2$@-ին հպվեք %1$lld անգամ։</string>
			<key>other</key>
			<string>Այժմ %2$@-ին հպվեք %1$lld անգամ։</string>
		</dict>
	</dict>
</dict>
</plist>

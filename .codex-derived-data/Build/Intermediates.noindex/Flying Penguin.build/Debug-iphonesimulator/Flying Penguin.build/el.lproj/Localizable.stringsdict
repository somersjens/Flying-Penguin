<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>notif.cards.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Παίξε %lld λεπτό σήμερα και μάζεψε λίγα ακόμα.</string>
			<key>other</key>
			<string>Παίξε %lld λεπτό σήμερα και μάζεψε λίγα ακόμα.</string>
		</dict>
	</dict>
	<key>notif.day3.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Ξεκινήστε ένα παιχνίδι %lld λεπτών και επεκτείνετε το καθημερινό σερί παιχνιδιού σας.</string>
			<key>other</key>
			<string>Ξεκινήστε ένα παιχνίδι %lld λεπτών και επεκτείνετε το καθημερινό σερί παιχνιδιού σας.</string>
		</dict>
	</dict>
	<key>notif.streak.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Παίξτε για %lld λεπτά και συνεχίστε το καθημερινό σας σερί παιχνιδιού!</string>
			<key>other</key>
			<string>Παίξτε για %lld λεπτά και συνεχίστε το καθημερινό σας σερί παιχνιδιού!</string>
		</dict>
	</dict>
	<key>notif.streak.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Το καθημερινό σερί παιχνιδιού σας έφτασε τις %lld ημέρες! 🔥</string>
			<key>other</key>
			<string>Το καθημερινό σερί παιχνιδιού σας έφτασε τις %lld ημέρες! 🔥</string>
		</dict>
	</dict>
	<key>parentGate.holdInstruction %@ %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Κράτησε πατημένο το %1$@ για %2$lld δευτερόλεπτα.</string>
			<key>other</key>
			<string>Κράτησε πατημένο το %1$@ για %2$lld δευτερόλεπτα.</string>
		</dict>
	</dict>
	<key>parentGate.tapInstruction %lld %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Τώρα πάτησε το %2$@ %1$lld φορές.</string>
			<key>other</key>
			<string>Τώρα πάτησε το %2$@ %1$lld φορές.</string>
		</dict>
	</dict>
</dict>
</plist>

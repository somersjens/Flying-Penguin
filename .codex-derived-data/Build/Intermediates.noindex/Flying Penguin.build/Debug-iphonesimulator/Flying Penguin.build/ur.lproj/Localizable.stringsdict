<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>notif.animal.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>صرف %lld حلقہ باقی! ⭕</string>
			<key>other</key>
			<string>صرف %lld حلقے باقی! ⭕</string>
		</dict>
	</dict>
	<key>notif.cards.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>آج %lld منٹ کھیلیں اور کچھ مزید جمع کریں۔</string>
			<key>other</key>
			<string>آج %lld منٹ کھیلیں اور کچھ مزید جمع کریں۔</string>
		</dict>
	</dict>
	<key>notif.cards.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld حلقہ جمع ہوا! ⭕</string>
			<key>other</key>
			<string>%lld حلقے جمع ہوئے! ⭕</string>
		</dict>
	</dict>
	<key>notif.day3.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld منٹ کا پلے سیشن شروع کریں اور اپنے روزانہ کھیلنے کے سلسلے کو بڑھا دیں۔</string>
			<key>other</key>
			<string>%lld منٹ کا پلے سیشن شروع کریں اور اپنے روزانہ کھیلنے کے سلسلے کو بڑھا دیں۔</string>
		</dict>
	</dict>
	<key>notif.streak.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld منٹ تک کھیلیں اور اپنی روزانہ کی کھیل کو جاری رکھیں!</string>
			<key>other</key>
			<string>%lld منٹ تک کھیلیں اور اپنی روزانہ کی کھیل کو جاری رکھیں!</string>
		</dict>
	</dict>
	<key>notif.streak.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>آپ کا روزانہ کھیلنے کا سلسلہ %lld دن تک پہنچ گیا ہے! 🔥</string>
			<key>other</key>
			<string>آپ کا روزانہ کھیلنے کا سلسلہ %lld دن تک پہنچ گیا ہے! 🔥</string>
		</dict>
	</dict>
	<key>notif.weekly.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>آپ کے پاس کل %lld حلقہ ہے۔ کچھ اور کے لیے تیار ہیں؟</string>
			<key>other</key>
			<string>آپ کے پاس کل %lld حلقے ہیں۔ کچھ اور کے لیے تیار ہیں؟</string>
		</dict>
	</dict>
	<key>notif.weekly.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>اس ہفتے %lld حلقہ! 🎉</string>
			<key>other</key>
			<string>اس ہفتے %lld حلقے! 🎉</string>
		</dict>
	</dict>
	<key>parentGate.holdInstruction %@ %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ کو %2$lld سیکنڈ دبائے رکھیں۔</string>
			<key>other</key>
			<string>%1$@ کو %2$lld سیکنڈ دبائے رکھیں۔</string>
		</dict>
	</dict>
	<key>parentGate.tapInstruction %lld %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>اب %2$@ کو %1$lld بار ٹیپ کریں۔</string>
			<key>other</key>
			<string>اب %2$@ کو %1$lld بار ٹیپ کریں۔</string>
		</dict>
	</dict>
</dict>
</plist>

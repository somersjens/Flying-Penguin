<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>notif.cards.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Spil %lld minut i dag, og saml lidt mere.</string>
			<key>other</key>
			<string>Spil %lld minut i dag, og saml lidt mere.</string>
		</dict>
	</dict>
	<key>notif.day3.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Start en %lld-minutters spillesession og forlænge din daglige spillerække.</string>
			<key>other</key>
			<string>Start en %lld-minutters spillesession og forlænge din daglige spillerække.</string>
		</dict>
	</dict>
	<key>notif.streak.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Spil i %lld minutter, og hold din daglige spillerække i gang!</string>
			<key>other</key>
			<string>Spil i %lld minutter, og hold din daglige spillerække i gang!</string>
		</dict>
	</dict>
	<key>notif.streak.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Din daglige spillerække har nået %lld dage! 🔥</string>
			<key>other</key>
			<string>Din daglige spillerække har nået %lld dage! 🔥</string>
		</dict>
	</dict>
	<key>parentGate.holdInstruction %@ %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Hold %1$@ nede i %2$lld sekunder.</string>
			<key>other</key>
			<string>Hold %1$@ nede i %2$lld sekunder.</string>
		</dict>
	</dict>
	<key>parentGate.tapInstruction %lld %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Tryk nu på %2$@ %1$lld gange.</string>
			<key>other</key>
			<string>Tryk nu på %2$@ %1$lld gange.</string>
		</dict>
	</dict>
</dict>
</plist>

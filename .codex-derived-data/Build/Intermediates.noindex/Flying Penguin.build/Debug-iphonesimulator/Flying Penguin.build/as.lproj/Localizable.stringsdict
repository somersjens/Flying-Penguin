<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>notif.cards.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>আজিৰ দিনটোত %lld মিনিট খেলি আৰু কেইটামান গোটোৱা।</string>
			<key>other</key>
			<string>আজিৰ দিনটোত %lld মিনিট খেলি আৰু কেইটামান গোটোৱা।</string>
		</dict>
	</dict>
	<key>notif.day3.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld মিনিটৰ খেলা অধিবেশন আৰম্ভ কৰক আৰু আপোনাৰ দৈনিক খেলাৰ ধাৰা বৃদ্ধি কৰক।</string>
			<key>other</key>
			<string>%lld মিনিটৰ খেলা অধিবেশন আৰম্ভ কৰক আৰু আপোনাৰ দৈনিক খেলাৰ ধাৰা বৃদ্ধি কৰক।</string>
		</dict>
	</dict>
	<key>notif.streak.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld মিনিট খেলক আৰু আপোনাৰ দৈনন্দিন খেলাৰ ধাৰাটো চলি থাকিব!</string>
			<key>other</key>
			<string>%lld মিনিট খেলক আৰু আপোনাৰ দৈনন্দিন খেলাৰ ধাৰাটো চলি থাকিব!</string>
		</dict>
	</dict>
	<key>notif.streak.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>আপোনাৰ দৈনিক খেলাৰ ধাৰা %lld দিন হ’ল! 🔥</string>
			<key>other</key>
			<string>আপোনাৰ দৈনিক খেলাৰ ধাৰা %lld দিন হ’ল! 🔥</string>
		</dict>
	</dict>
	<key>parentGate.holdInstruction %@ %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@টো %2$lld ছেকেণ্ড ধৰি ৰাখা।</string>
			<key>other</key>
			<string>%1$@টো %2$lld ছেকেণ্ড ধৰি ৰাখা।</string>
		</dict>
	</dict>
	<key>parentGate.tapInstruction %lld %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>এতিয়া %2$@টো %1$lld বাৰ টেপ কৰা।</string>
			<key>other</key>
			<string>এতিয়া %2$@টো %1$lld বাৰ টেপ কৰা।</string>
		</dict>
	</dict>
</dict>
</plist>

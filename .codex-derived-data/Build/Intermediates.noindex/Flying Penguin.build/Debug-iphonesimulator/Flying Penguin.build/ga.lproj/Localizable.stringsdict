<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>notif.cards.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Imir ar feadh %lld nóiméad inniu agus bailigh cúpla ceann eile.</string>
			<key>other</key>
			<string>Imir ar feadh %lld nóiméad inniu agus bailigh cúpla ceann eile.</string>
		</dict>
	</dict>
	<key>notif.day3.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Tosaigh seisiún súgartha %lld-nóiméad agus síneadh do stríoc imeartha laethúil.</string>
			<key>other</key>
			<string>Tosaigh seisiún súgartha %lld-nóiméad agus síneadh do stríoc imeartha laethúil.</string>
		</dict>
	</dict>
	<key>notif.streak.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Seinn ar feadh %lld nóiméad agus coinnigh do stríoc imeartha laethúil ag dul!</string>
			<key>other</key>
			<string>Seinn ar feadh %lld nóiméad agus coinnigh do stríoc imeartha laethúil ag dul!</string>
		</dict>
	</dict>
	<key>notif.streak.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Tá do stríoc imeartha laethúil %lld lá bainte amach! 🔥</string>
			<key>other</key>
			<string>Tá do stríoc imeartha laethúil %lld lá bainte amach! 🔥</string>
		</dict>
	</dict>
	<key>parentGate.holdInstruction %@ %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Coinnigh an %1$@ síos ar feadh %2$lld soicind.</string>
			<key>other</key>
			<string>Coinnigh an %1$@ síos ar feadh %2$lld soicind.</string>
		</dict>
	</dict>
	<key>parentGate.tapInstruction %lld %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Anois tapáil an %2$@ %1$lld uair.</string>
			<key>other</key>
			<string>Anois tapáil an %2$@ %1$lld uair.</string>
		</dict>
	</dict>
</dict>
</plist>

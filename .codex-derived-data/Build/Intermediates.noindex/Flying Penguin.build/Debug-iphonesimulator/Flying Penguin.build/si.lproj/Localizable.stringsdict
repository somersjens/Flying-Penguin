<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>notif.animal.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>තව %lldක් විතරයි! ⭕</string>
			<key>other</key>
			<string>තව %lldක් විතරයි! ⭕</string>
		</dict>
	</dict>
	<key>notif.cards.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>අද විනාඩි %lldක් සෙල්ලම් කරලා තව ටිකක් එකතු කරන්න.</string>
			<key>other</key>
			<string>අද විනාඩි %lldක් සෙල්ලම් කරලා තව ටිකක් එකතු කරන්න.</string>
		</dict>
	</dict>
	<key>notif.cards.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lldක් එකතු කළා! ⭕</string>
			<key>other</key>
			<string>%lldක් එකතු කළා! ⭕</string>
		</dict>
	</dict>
	<key>notif.day3.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>මිනිත්තු %lldක ක්‍රීඩා සැසියක් ආරම්භ කර ඔබේ දෛනික ක්‍රීඩා මාලාව දිගු කරන්න.</string>
			<key>other</key>
			<string>මිනිත්තු %lldක ක්‍රීඩා සැසියක් ආරම්භ කර ඔබේ දෛනික ක්‍රීඩා මාලාව දිගු කරන්න.</string>
		</dict>
	</dict>
	<key>notif.streak.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>මිනිත්තු %lld ක් ක්‍රීඩා කර ඔබේ දෛනික ක්‍රීඩා මාලාව දිගටම කරගෙන යන්න!</string>
			<key>other</key>
			<string>මිනිත්තු %lld ක් ක්‍රීඩා කර ඔබේ දෛනික ක්‍රීඩා මාලාව දිගටම කරගෙන යන්න!</string>
		</dict>
	</dict>
	<key>notif.streak.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ඔබේ දෛනික ක්‍රීඩා මාලාව දින %lldකට ළඟා වී ඇත! 🔥</string>
			<key>other</key>
			<string>ඔබේ දෛනික ක්‍රීඩා මාලාව දින %lldකට ළඟා වී ඇත! 🔥</string>
		</dict>
	</dict>
	<key>notif.weekly.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>මුළු එකතුව %lldයි. තව ටිකක් ගන්න සූදානම්ද?</string>
			<key>other</key>
			<string>මුළු එකතුව %lldයි. තව ටිකක් ගන්න සූදානම්ද?</string>
		</dict>
	</dict>
	<key>notif.weekly.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>මේ සතියේ %lld! 🎉</string>
			<key>other</key>
			<string>මේ සතියේ %lld! 🎉</string>
		</dict>
	</dict>
	<key>parentGate.holdInstruction %@ %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ තත්පර %2$lldක් ඔබාගෙන සිටින්න.</string>
			<key>other</key>
			<string>%1$@ තත්පර %2$lldක් ඔබාගෙන සිටින්න.</string>
		</dict>
	</dict>
	<key>parentGate.tapInstruction %lld %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>දැන් %2$@ %1$lld වරක් තට්ටු කරන්න.</string>
			<key>other</key>
			<string>දැන් %2$@ %1$lld වරක් තට්ටු කරන්න.</string>
		</dict>
	</dict>
</dict>
</plist>

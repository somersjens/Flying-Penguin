<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>notif.animal.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Zostáva už len %lld obruč! ⭕</string>
			<key>other</key>
			<string>Zostáva už len %lld! ⭕</string>
		</dict>
	</dict>
	<key>notif.cards.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Dnes hraj %lld min a nazbieraj ešte pár.</string>
			<key>other</key>
			<string>Dnes hraj %lld min a nazbieraj ešte pár.</string>
		</dict>
	</dict>
	<key>notif.cards.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Zozbieraný %lld obruč! ⭕</string>
			<key>other</key>
			<string>Zozbierané %lld! ⭕</string>
		</dict>
	</dict>
	<key>notif.day3.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Začnite %lld-minútovú hernú reláciu a predĺžte si dennú sériu hrania.</string>
			<key>other</key>
			<string>Začnite %lld-minútovú hernú reláciu a predĺžte si dennú sériu hrania.</string>
		</dict>
	</dict>
	<key>notif.streak.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Hrajte %lld minút a udržujte svoju každodennú hernú sériu v chode!</string>
			<key>other</key>
			<string>Hrajte %lld minút a udržujte svoju každodennú hernú sériu v chode!</string>
		</dict>
	</dict>
	<key>notif.streak.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Vaša denná séria hrania dosiahla %lld dní! 🔥</string>
			<key>other</key>
			<string>Vaša denná séria hrania dosiahla %lld dní! 🔥</string>
		</dict>
	</dict>
	<key>notif.weekly.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Celkovo máš %lld obruč. Pripravený/á na ďalšie?</string>
			<key>other</key>
			<string>Celkovo máš %lld. Pripravený/á na ďalšie?</string>
		</dict>
	</dict>
	<key>notif.weekly.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld obruč tento týždeň! 🎉</string>
			<key>other</key>
			<string>%lld tento týždeň! 🎉</string>
		</dict>
	</dict>
	<key>parentGate.holdInstruction %@ %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Podrž %1$@ %2$lld sekúnd.</string>
			<key>other</key>
			<string>Podrž %1$@ %2$lld sekúnd.</string>
		</dict>
	</dict>
	<key>parentGate.tapInstruction %lld %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Teraz %1$lld-krát ťukni na %2$@.</string>
			<key>other</key>
			<string>Teraz %1$lld-krát ťukni na %2$@.</string>
		</dict>
	</dict>
</dict>
</plist>

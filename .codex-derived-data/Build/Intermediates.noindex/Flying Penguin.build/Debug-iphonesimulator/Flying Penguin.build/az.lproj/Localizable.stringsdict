<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>notif.animal.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Cəmi %lld qalıb! ⭕</string>
			<key>other</key>
			<string>Cəmi %lld qalıb! ⭕</string>
		</dict>
	</dict>
	<key>notif.cards.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Bu gün %lld dəqiqə oyna və bir neçəsini də topla.</string>
			<key>other</key>
			<string>Bu gün %lld dəqiqə oyna və bir neçəsini də topla.</string>
		</dict>
	</dict>
	<key>notif.cards.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld toplandı! ⭕</string>
			<key>other</key>
			<string>%lld toplandı! ⭕</string>
		</dict>
	</dict>
	<key>notif.day3.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld dəqiqəlik oyun seansına başlayın və gündəlik oyun seriyanızı artırın.</string>
			<key>other</key>
			<string>%lld dəqiqəlik oyun seansına başlayın və gündəlik oyun seriyanızı artırın.</string>
		</dict>
	</dict>
	<key>notif.streak.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld dəqiqə oynayın və gündəlik oyun seriyanızı davam etdirin!</string>
			<key>other</key>
			<string>%lld dəqiqə oynayın və gündəlik oyun seriyanızı davam etdirin!</string>
		</dict>
	</dict>
	<key>notif.streak.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Gündəlik oyun seriyanız %lld günə çatdı! 🔥</string>
			<key>other</key>
			<string>Gündəlik oyun seriyanız %lld günə çatdı! 🔥</string>
		</dict>
	</dict>
	<key>notif.weekly.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Cəmi %lld var. Bir neçəsinə də hazırsan?</string>
			<key>other</key>
			<string>Cəmi %lld var. Bir neçəsinə də hazırsan?</string>
		</dict>
	</dict>
	<key>notif.weekly.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Bu həftə %lld! 🎉</string>
			<key>other</key>
			<string>Bu həftə %lld! 🎉</string>
		</dict>
	</dict>
	<key>parentGate.holdInstruction %@ %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ üzərində %2$lld saniyə basıb saxla.</string>
			<key>other</key>
			<string>%1$@ üzərində %2$lld saniyə basıb saxla.</string>
		</dict>
	</dict>
	<key>parentGate.tapInstruction %lld %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>İndi %2$@ üzərinə %1$lld dəfə toxun.</string>
			<key>other</key>
			<string>İndi %2$@ üzərinə %1$lld dəfə toxun.</string>
		</dict>
	</dict>
</dict>
</plist>

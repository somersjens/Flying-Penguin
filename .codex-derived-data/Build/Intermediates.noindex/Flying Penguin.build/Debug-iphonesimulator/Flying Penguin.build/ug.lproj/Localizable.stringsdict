<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>notif.cards.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>بۈگۈن %lld مىنۇت ئويناپ، يەنە بىرنەچچە توپلا.</string>
			<key>other</key>
			<string>بۈگۈن %lld مىنۇت ئويناپ، يەنە بىرنەچچە توپلا.</string>
		</dict>
	</dict>
	<key>notif.day3.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld مىنۇتلۇق ئويۇننى باشلاڭ ۋە كۈندىلىك ئويناش ۋاقتىڭىزنى ئۇزارتىڭ.</string>
			<key>other</key>
			<string>%lld مىنۇتلۇق ئويۇننى باشلاڭ ۋە كۈندىلىك ئويناش ۋاقتىڭىزنى ئۇزارتىڭ.</string>
		</dict>
	</dict>
	<key>notif.streak.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld مىنۇت ئويناڭ ھەمدە كۈندىلىك ئويۇنلىرىڭىزنى داۋاملاشتۇرۇڭ!</string>
			<key>other</key>
			<string>%lld مىنۇت ئويناڭ ھەمدە كۈندىلىك ئويۇنلىرىڭىزنى داۋاملاشتۇرۇڭ!</string>
		</dict>
	</dict>
	<key>notif.streak.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>كۈندىلىك ئويناش ۋاقتىڭىز %lld كۈنگە يەتتى! 🔥</string>
			<key>other</key>
			<string>كۈندىلىك ئويناش ۋاقتىڭىز %lld كۈنگە يەتتى! 🔥</string>
		</dict>
	</dict>
	<key>parentGate.holdInstruction %@ %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ نى %2$lld سېكۇنت بېسىپ تۇرۇڭ.</string>
			<key>other</key>
			<string>%1$@ نى %2$lld سېكۇنت بېسىپ تۇرۇڭ.</string>
		</dict>
	</dict>
	<key>parentGate.tapInstruction %lld %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ھازىر %2$@ نى %1$lld قېتىم چېكىڭ.</string>
			<key>other</key>
			<string>ھازىر %2$@ نى %1$lld قېتىم چېكىڭ.</string>
		</dict>
	</dict>
</dict>
</plist>

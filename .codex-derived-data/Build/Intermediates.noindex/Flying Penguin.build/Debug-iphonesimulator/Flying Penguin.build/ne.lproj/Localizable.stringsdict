<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>notif.animal.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>अब %lld मात्रै बाँकी! ⭕</string>
			<key>other</key>
			<string>अब %lld मात्रै बाँकी! ⭕</string>
		</dict>
	</dict>
	<key>notif.cards.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>आज %lld मिनेट खेल र अझै केही जम्मा गर।</string>
			<key>other</key>
			<string>आज %lld मिनेट खेल र अझै केही जम्मा गर।</string>
		</dict>
	</dict>
	<key>notif.cards.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld सङ्कलन भयो! ⭕</string>
			<key>other</key>
			<string>%lld सङ्कलन भयो! ⭕</string>
		</dict>
	</dict>
	<key>notif.day3.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld-मिनेट खेल सत्र सुरु गर्नुहोस् र आफ्नो दैनिक खेल स्ट्रीक विस्तार गर्नुहोस्।</string>
			<key>other</key>
			<string>%lld-मिनेट खेल सत्र सुरु गर्नुहोस् र आफ्नो दैनिक खेल स्ट्रीक विस्तार गर्नुहोस्।</string>
		</dict>
	</dict>
	<key>notif.streak.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld मिनेटको लागि खेल्नुहोस् र तपाईंको दैनिक प्ले स्ट्रीक जारी राख्नुहोस्!</string>
			<key>other</key>
			<string>%lld मिनेटको लागि खेल्नुहोस् र तपाईंको दैनिक प्ले स्ट्रीक जारी राख्नुहोस्!</string>
		</dict>
	</dict>
	<key>notif.streak.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>तपाइँको दैनिक प्ले स्ट्रीक %lld दिन पुगेको छ! 🔥</string>
			<key>other</key>
			<string>तपाइँको दैनिक प्ले स्ट्रीक %lld दिन पुगेको छ! 🔥</string>
		</dict>
	</dict>
	<key>notif.weekly.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>तिमीसँग जम्मा %lld छ। अझ केहीका लागि तयार?</string>
			<key>other</key>
			<string>तिमीसँग जम्मा %lld छ। अझ केहीका लागि तयार?</string>
		</dict>
	</dict>
	<key>notif.weekly.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>यो हप्ता %lld! 🎉</string>
			<key>other</key>
			<string>यो हप्ता %lld! 🎉</string>
		</dict>
	</dict>
	<key>parentGate.holdInstruction %@ %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ लाई %2$lld सेकेन्ड थिचिराख्नुहोस्।</string>
			<key>other</key>
			<string>%1$@ लाई %2$lld सेकेन्ड थिचिराख्नुहोस्।</string>
		</dict>
	</dict>
	<key>parentGate.tapInstruction %lld %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>अब %2$@ मा %1$lld पटक ट्याप गर्नुहोस्।</string>
			<key>other</key>
			<string>अब %2$@ मा %1$lld पटक ट्याप गर्नुहोस्।</string>
		</dict>
	</dict>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>notif.animal.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ਹੁਣ ਸਿਰਫ਼ %lld ਛੱਲਾ ਬਾਕੀ! ⭕</string>
			<key>other</key>
			<string>ਹੁਣ ਸਿਰਫ਼ %lld ਬਾਕੀ! ⭕</string>
		</dict>
	</dict>
	<key>notif.cards.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ਅੱਜ %lld ਮਿੰਟ ਖੇਡੋ ਅਤੇ ਕੁਝ ਹੋਰ ਇਕੱਠੇ ਕਰੋ।</string>
			<key>other</key>
			<string>ਅੱਜ %lld ਮਿੰਟ ਖੇਡੋ ਅਤੇ ਕੁਝ ਹੋਰ ਇਕੱਠੇ ਕਰੋ।</string>
		</dict>
	</dict>
	<key>notif.cards.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਛੱਲਾ ਇਕੱਠਾ ਹੋਇਆ! ⭕</string>
			<key>other</key>
			<string>%lld ਇਕੱਠੇ ਹੋਏ! ⭕</string>
		</dict>
	</dict>
	<key>notif.day3.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld-ਮਿੰਟ ਦਾ ਪਲੇ ਸੈਸ਼ਨ ਸ਼ੁਰੂ ਕਰੋ ਅਤੇ ਆਪਣੀ ਰੋਜ਼ਾਨਾ ਖੇਡਣ ਦੀ ਲੜੀ ਨੂੰ ਵਧਾਓ।</string>
			<key>other</key>
			<string>%lld-ਮਿੰਟ ਦਾ ਪਲੇ ਸੈਸ਼ਨ ਸ਼ੁਰੂ ਕਰੋ ਅਤੇ ਆਪਣੀ ਰੋਜ਼ਾਨਾ ਖੇਡਣ ਦੀ ਲੜੀ ਨੂੰ ਵਧਾਓ।</string>
		</dict>
	</dict>
	<key>notif.streak.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਮਿੰਟ ਲਈ ਖੇਡੋ ਅਤੇ ਆਪਣੀ ਰੋਜ਼ਾਨਾ ਖੇਡਣ ਦੀ ਲੜੀ ਨੂੰ ਜਾਰੀ ਰੱਖੋ!</string>
			<key>other</key>
			<string>%lld ਮਿੰਟ ਲਈ ਖੇਡੋ ਅਤੇ ਆਪਣੀ ਰੋਜ਼ਾਨਾ ਖੇਡਣ ਦੀ ਲੜੀ ਨੂੰ ਜਾਰੀ ਰੱਖੋ!</string>
		</dict>
	</dict>
	<key>notif.streak.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ਤੁਹਾਡੀ ਰੋਜ਼ਾਨਾ ਖੇਡਣ ਦੀ ਸਟ੍ਰੀਕ %lld ਦਿਨਾਂ ਤੱਕ ਪਹੁੰਚ ਗਈ ਹੈ! 🔥</string>
			<key>other</key>
			<string>ਤੁਹਾਡੀ ਰੋਜ਼ਾਨਾ ਖੇਡਣ ਦੀ ਸਟ੍ਰੀਕ %lld ਦਿਨਾਂ ਤੱਕ ਪਹੁੰਚ ਗਈ ਹੈ! 🔥</string>
		</dict>
	</dict>
	<key>notif.weekly.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ਤੁਹਾਡੇ ਕੋਲ ਕੁੱਲ %lld ਛੱਲਾ ਹੈ। ਹੋਰ ਲਈ ਤਿਆਰ?</string>
			<key>other</key>
			<string>ਤੁਹਾਡੇ ਕੋਲ ਕੁੱਲ %lld ਹਨ। ਹੋਰ ਲਈ ਤਿਆਰ?</string>
		</dict>
	</dict>
	<key>notif.weekly.title %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ਇਸ ਹਫ਼ਤੇ %lld ਛੱਲਾ! 🎉</string>
			<key>other</key>
			<string>ਇਸ ਹਫ਼ਤੇ %lld! 🎉</string>
		</dict>
	</dict>
	<key>parentGate.holdInstruction %@ %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ ਨੂੰ %2$lld ਸਕਿੰਟ ਦਬਾ ਕੇ ਰੱਖੋ।</string>
			<key>other</key>
			<string>%1$@ ਨੂੰ %2$lld ਸਕਿੰਟ ਦਬਾ ਕੇ ਰੱਖੋ।</string>
		</dict>
	</dict>
	<key>parentGate.tapInstruction %lld %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ਹੁਣ %2$@ ਨੂੰ %1$lld ਵਾਰ ਟੈਪ ਕਰੋ।</string>
			<key>other</key>
			<string>ਹੁਣ %2$@ ਨੂੰ %1$lld ਵਾਰ ਟੈਪ ਕਰੋ।</string>
		</dict>
	</dict>
</dict>
</plist>
